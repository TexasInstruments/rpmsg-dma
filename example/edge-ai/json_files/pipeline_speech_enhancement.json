        "hop_size": 160,
        "model_elems": 322,
        "total_frames": 401,
        "batch_n": 64
      }
    },
    {
      "stage_id": "deinterleave",
      "service": "generic",
      "message_type": "C7X_DEINTERLEAVE_MSG_ANALYZE",
